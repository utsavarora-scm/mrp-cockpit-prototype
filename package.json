{
  "name": "next-prototype-template",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "demo:reset": "curl -sf -X POST http://localhost:3003/api/demo/reset -o /dev/null -w 'demo reset in %{time_total}s\\n' || echo 'dev server not running on 3003'",
    "dev": "turbo run dev",
    "find-deadcode": "turbo run find-deadcode",
    "find-deadcode:web": "pnpm --filter web find-deadcode",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css,scss,js,jsx,html,mdx,yml,yaml}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,md,json,css,scss,js,jsx,html,mdx,yml,yaml}\"",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "prepare": "husky",
    "start": "turbo run start",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-query-devtools": "^5.91.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.18.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-day-picker": "9.7.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.57.0",
    "react-resizable-panels": "^3.0.2",
    "recharts": "^2.15.3",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.2.4",
    "vaul": "^1.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint-react/eslint-plugin": "^2.5.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "turbo": "^2.5.4",
    "typescript": "5.8.2"
  }
}
